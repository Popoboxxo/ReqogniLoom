# Keep throwaway/debug scripts and test artifacts out of the production image
# (#146 — backend/Dockerfile:72 does `COPY . .`, so anything not excluded here
# ends up shipped to production).
*_tmp.py
fix_*.py
seed_*.py
tests/
**/tests/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/

# VCS / editor artifacts
.git/
.gitignore
*.md.old

# Local env files (never ship secrets into the image)
.env
.env.*
!.env.example

# Database backups (generated by scripts/backup.sh) — full dumpdata exports
# including user accounts, sessions and tenant data. .gitignore already
# excludes new ones (backups/), but .dockerignore is evaluated separately
# from git, so it needs its own rule or a COPY . . build ships them anyway.
backups/
