{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.popoboxxo/reqogniloom",
  "description": "ReqogniLoom MCP server: requirements, architecture and test management.",
  "version": "1.8.0-beta.29",
  "repository": {
    "url": "https://github.com/Popoboxxo/ReqogniLoom",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{host}/mcp/",
      "variables": {
        "host": {
          "description": "Hostname of your self-hosted ReqogniLoom instance",
          "isRequired": true
        }
      },
      "headers": [
        {
          "name": "X-API-Key",
          "value": "{REQOGNILOOM_API_KEY}",
          "isSecret": true,
          "isRequired": true
        }
      ]
    }
  ]
}
