# ReqogniLoom Environment Variables
# Copy to .env and adjust values before running.
# NEVER commit .env with real secrets.
#
# Architecture: ADR-08 (Self-Hosted Docker Compose)
# Production Setup: See docker-compose.yml and README.md
# ─────────────────────────────────────────────────────────

# ─── Django Security (REQUIRED in Production) ──────────────────────
# Generate SECRET_KEY with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-long-random-string
# Generate AUTH_JWT_SECRET with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=CHANGE-ME-IN-PRODUCTION-use-a-long-random-string
# SA-34: server-side pepper for API-key hashes. Optional (defence in depth: the
# keys are 40 random chars, so the hash was never brute-forceable) but strongly
# recommended in production - it means a stolen DB dump alone cannot be used to
# test candidate keys offline. NOT retroactive: setting it peppers only NEWLY
# created keys; existing keys keep working unpeppered until they are rotated.
# Changing or removing the value invalidates every peppered key (forced
# rotation for all clients), so treat it like FIELD_ENCRYPTION_KEY.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
API_KEY_PEPPER=
# SA-32: refresh-token rotation detects reuse — replaying an already-exchanged
# refresh token revokes the whole session family. 0 = strict (default).
# Raise it (e.g. 10) only if users report being logged out while working in
# several browser tabs: tabs share the cookie jar but each runs its own
# single-flight refresh guard, so two can legitimately present the same token.
# A non-zero window also means a replay inside it is NOT detected.
# AUTH_REFRESH_REUSE_GRACE_SECONDS=0
# Deployment environment. Default "production" hard-forces DEBUG=False even if
# DEBUG=True is set below (REQ-115 leak protection). Use development|dev|local|test
# to allow DEBUG=True. The dev docker-compose.override.yml sets this to development.
DJANGO_ENV=production
DEBUG=False
# B1: HTTP → HTTPS redirect. DEFAULTS TO FALSE (opt-in).
# Set to True ONLY if a TLS-terminating reverse proxy (nginx, Traefik, HAProxy, etc.)
# is in front of this app and forwards traffic as plain HTTP with X-Forwarded-Proto: https.
# If True but no TLS proxy exists, ALL requests redirect to https:// where nothing listens
# → deployment becomes unreachable. The bundled docker-compose stack has NO TLS termination,
# so leaving this False (the default) is correct for HTTP-only setups. Set to True in
# production behind a TLS-terminating load balancer.
#SECURE_SSL_REDIRECT=True
# Controls the `Secure` flag on the httpOnly auth cookie. Defaults to `not DEBUG`
# when left unset (see backend/reqogniloom/settings.py) — the safe choice for a
# real production deployment behind TLS. Deliberately left unset here (issue
# #589): the bundled docker-compose stack has no TLS termination anywhere, so a
# hardcoded `True` broke login for every deployment that just copies this file
# and follows the documented HTTP quickstart — browsers silently drop `Secure`
# cookies over plain HTTP. docker-compose.override.yml's dev profile sets an
# explicit False default for the same reason DEBUG/DJANGO_ENV get one there.
# Set this explicitly to True once you put the app behind TLS.
#AUTH_COOKIE_SECURE=True
# For production: list your server hostnames/IPs separated by commas
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS allowlist (REQ-081): comma-separated origins allowed to send credentialed
# cross-origin requests. Never use "*" together with credentials — set the exact
# frontend origins (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Field-level encryption key (REQ-081, REQUIRED — no default, startup fails
# without it). Encrypts persistence.LlmSettings.api_key at rest. Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without re-encrypting existing rows makes their stored
# api_key unreadable — keep it stable, and back it up like any other secret.
FIELD_ENCRYPTION_KEY=CHANGE-ME-generate-with-python-cryptography-fernet

# ─── API Rate Limiting (GitHub #269) ───────────────────────────────
# DRF rate syntax: "<count>/<period>" where period is second|minute|hour|day
# (s|m|h|d also work). Set a variable to an EMPTY value to disable that
# throttle completely. The values below are the production defaults; when
# DJANGO_ENV is development|dev|local|test the built-in defaults are far
# higher so e2e suites do not hit 429.
#
# Generic ceiling per authenticated user, across all endpoints. Raise it for
# API-heavy integrations, lower it for a public-facing deployment.
API_RATE_LIMIT_USER=600/min
# Ceiling per client IP for requests without a valid credential (only the
# genuinely public endpoints: schema, health).
API_RATE_LIMIT_ANON=120/min
# FAILED logins per (client IP, username) pair. A successful login clears this
# counter, so correct credentials are never refused because of earlier typos —
# by yours or by anyone else behind the same NAT.
LOGIN_THROTTLE_RATE=10/min
# FAILED logins per client IP across ALL usernames (anti credential-spraying).
# Keep this clearly above LOGIN_THROTTLE_RATE; setting it too low reintroduces
# the per-IP lockout that #269 reported.
LOGIN_IP_THROTTLE_RATE=60/min
# Requests per client IP against the unauthenticated token-refresh endpoint.
REFRESH_THROTTLE_RATE=30/min
# Requests per API key against the MCP transport endpoints (/mcp/*). Those are
# plain Django views, so API_RATE_LIMIT_USER above never applied to them.
# Deliberately below API_RATE_LIMIT_USER: an MCP tool call is on average much
# more expensive than a REST read, and LLM-backed tools cost real money.
MCP_RATE_LIMIT_KEY=240/min
# Requests per client IP against /mcp/*, across all credentials and including
# requests presenting none — this is what bounds an unauthenticated flood
# against the SSE handshake. Keep it clearly above MCP_RATE_LIMIT_KEY: behind a
# reverse proxy that does not forward X-Forwarded-For, every caller shares this
# single bucket.
MCP_RATE_LIMIT_IP=1200/min

# ─── PostgreSQL (ARCH-L1-010 PersistenceLayer) ────────────────────
# Production: Use strong, random password (e.g., 32+ characters)
DB_NAME=reqogniloom
# Superuser (Postgres bootstrap role, POSTGRES_USER). Used ONLY by the
# `migrate` service (docker-compose.yml) to run schema migrations — RLS
# (REQ-L2-PL-010) does not restrict superusers, so this role must never
# be used for runtime request traffic.
DB_USER=reqogniloom
DB_PASSWORD=CHANGE-ME-strong-password
# Least-privilege application role (created by
# persistence/migrations/0048_app_role.py). backend/celery/celery-beat
# authenticate as this role so RLS tenant-isolation policies actually apply.
DB_APP_USER=reqogniloom_app
DB_APP_PASSWORD=CHANGE-ME-strong-app-password
# DB_HOST and DB_PORT are set to service names in docker-compose.yml
# Override here only for external database connections:
# DB_HOST=external-db.example.com
# DB_PORT=5432

# ─── Tenant (ADR-03, ARCH-L1-011) ────────────────────────────────
# v1: single default tenant. v2: no data migration required.
DEFAULT_TENANT_ID=1

# ─── LLM Provider (ARCH-L1-009 LlmAdapter, ADR-02) ────────────────
# Supported: mock | anthropic | openai | ollama | azure
# Set to 'mock' for development without external AI features.
# Core functionality (CRUD, Traceability, Baselines) works without LLM.
LLM_PROVIDER=mock
# Comma-separated list of enabled LLM capabilities. Available: validate_artifact,
# decompose_requirement, check_consistency, derive_requirements. Leave empty to
# disable all AI features.
LLM_CAPABILITIES=validate_artifact,decompose_requirement,check_consistency,derive_requirements
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# SA-33 (SSRF guard): the admin-configurable LLM base_url is checked against
# private/loopback/link-local/metadata address ranges before it is stored,
# because the backend makes server-side requests to it. Defaults to permissive
# outside production (DJANGO_ENV != production) so a local Ollama on
# http://localhost:11434 keeps working, and to deny in production.
# Set to True only if you knowingly run an internal model endpoint; prefer the
# narrower allowlist below. Note: DNS rebinding is a documented residual risk
# (see backend/llm_adapter/url_guard.py).
# LLM_ALLOW_PRIVATE_BASE_URL=False
# Comma-separated hosts allowed to resolve to a private address, e.g. "ollama".
# LLM_BASE_URL_ALLOWED_HOSTS=

# Issue #342: workspace-wide LLM tools (ai_derivation.derive_glossary_from_workspace,
# traceability.suggest_links, audit.ai_review) prompt over the entire workspace and
# need far longer than the per-artifact cap LLM_SYNC_TIMEOUT (25s). Seconds.
# NOTE: any HTTP proxy in front of the backend needs a matching read timeout
# (nginx defaults to 60s proxy_read_timeout).
LLM_LONG_RUNNING_TIMEOUT=180

# Examples — uncomment and fill to enable AI features:
#
# Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022
#
# OpenAI (GPT):
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o
#
# Ollama (local):
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1
#
# Azure OpenAI:
# LLM_PROVIDER=azure
# LLM_API_KEY=<azure-api-key>
# LLM_BASE_URL=https://<resource-name>.openai.azure.com/
# LLM_MODEL=<deployment-name>

# ─── AI Long-Term Memory & Embeddings (Spec 2026-08-24) ───────────
# Two independent, pluggable abstractions — both self-hosted by default,
# no external service required.
#
# Supported EMBEDDING_PROVIDER: sentence-transformers (default, 384-dim,
# runs in-process in the backend/celery containers, no extra service)
# | ollama (768-dim) | openai (1536-dim) | mock (384-dim)
#
# ⚠ DIMENSION (issue #794): all pgvector columns are vector(384), sized for
# the default provider. Switching to a provider with a different native
# width (ollama, openai) SILENTLY disables embedding writes and semantic
# search — the width guard skips them, it does not error. `manage.py check`
# reports the mismatch as llm_adapter.W001 and the first skipped write logs
# at WARNING. To actually run such a provider you must change
# backend/persistence/embedding_dimensions.py's EMBEDDING_VECTOR_DIMENSIONS,
# generate the migrations, and re-run `manage.py backfill_embeddings`
# (pgvector cannot cast between widths, so existing vectors are discarded).
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=
# Only used when EMBEDDING_PROVIDER=ollama:
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_TIMEOUT=10

# Supported MEMORY_BACKEND: pgvector (default, uses this project's own
# Postgres/pgvector, no extra service) | honcho (optional, delegates memory
# to an external Honcho instance — see backend/memory/honcho_backend.py)
MEMORY_BACKEND=pgvector
# Only used when MEMORY_BACKEND=honcho:
HONCHO_BASE_URL=
HONCHO_API_KEY=
#
# Honcho caveats (all verified against honcho-ai 2.3.0):
#   - Requires the `honcho-ai` package (in backend/requirements.txt). This is
#     the Plastic Labs memory SDK, NOT the same-named legacy Procfile runner.
#   - `source_event_id` provenance is dropped and semantic-search results carry
#     no distance score — Honcho's API exposes neither.
#   - The MCP tool `memory_forget` stays pgvector-only: its ownership check
#     resolves the entry id against this project's own memory tables, and
#     Honcho ids are nanoids that never match. Memory write/query/list work.
#
# Examples — uncomment and fill to enable an optional external backend:
#
# Ollama embeddings (nomic-embed-text):
# EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# EMBEDDING_MODEL_NAME=nomic-embed-text
#
# Honcho memory backend:
# MEMORY_BACKEND=honcho
# HONCHO_BASE_URL=https://your-honcho-instance.example.com
# HONCHO_API_KEY=<honcho-api-key>
#
# Pinning Honcho's own reasoning LLM to this project's opencode_go provider:
#
# These variables do NOT belong in this file — they are configured on the
# HONCHO SERVER deployment, which lives outside this repository. Honcho runs
# its deriver/dialectic/summary/dream LLM calls server-side, and the client
# SDK exposes no provider, model, API-key or base-URL parameter at all (its
# workspace/peer config models are pydantic `extra="forbid"` and carry only
# enabled/custom_instructions/counters). `peer.chat(reasoning_level=...)` only
# picks among the models the server already has configured.
#
# On the Honcho server's own .env, opencode_go is reachable because it is
# OpenAI-compatible (same endpoint LLM_PROVIDER=opencode_go uses here):
#   LLM_OPENAI_API_KEY=<your-opencode-go-key>
#   DERIVER_MODEL_CONFIG__TRANSPORT=openai
#   DERIVER_MODEL_CONFIG__MODEL=mimo-v2.5
#   DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=https://opencode.ai/zen/go/v1
#   DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
#   DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=mimo-v2.5
#   DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=https://opencode.ai/zen/go/v1
#   (repeat the DIALECTIC_LEVELS__<level>__ trio for minimal/medium/high/max)
#
# Model id: `mimo-v2.5` is the id on the opencode-go endpoint
# (https://opencode.ai/zen/go/v1). Do not use `mimo-v2.5-free` — that id only
# exists on the non-Go zen endpoint (https://opencode.ai/zen/v1).
# Honcho also needs an embedding model; opencode_go serves no embeddings, so
# leave EMBEDDING_MODEL_CONFIG__* pointed at a provider that does.
#
# See docker-compose.override.example.yml for the matching Compose service
# stubs (copy to docker-compose.override.yml and uncomment what you need).

# ─── Celery / Redis (ARCH-L1-016 ResilienceOrchestrator) ──────────
# For Docker Compose, these connect to the 'redis' service in the compose stack.
# Redis authentication (REQ-057): Optional in development (empty password = no requirepass).
# For production, set a strong password (32+ random characters) and the URLs will include credentials.
# For external Redis, replace 'redis' with hostname/IP:
# REDIS_PASSWORD=your-strong-redis-password
# CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis.example.com:6379/0
# CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis.example.com:6379/0
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:-}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:-}@redis:6379/0

# ─── System Admin Account (first-start self-init, REQ-188) ───────
# The application self-initialises on first start via a post_migrate receiver
# that runs inside the one-shot `migrate` service (docker-compose.yml): it
# provisions this admin account AND the base workspace's default workflows so
# login and workflows work immediately — no manual seed or provisioning step.
# Provisioning is create-only: the password is set once, at user creation, and is
# never reset on later restarts (an admin who changed their password via the UI
# keeps it). Username/email are optional (defaults below). SYSTEM_ADMIN_PASSWORD
# is REQUIRED on a fresh system: without it the self-init logs a warning and
# skips admin creation. Choose a strong value for production.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_EMAIL=admin@demo.local
SYSTEM_ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# ─── Frontend (ARCH-L1-001 ReactFrontend) ────────────────────────
# Backend API URL. In production, match your server hostname.
VITE_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed frontend hostnames (CORS).
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend nginx port mapping: REQ-059 runs nginx as non-root user on port 8080 internally,
# mapped to port 80 on host (configurable in docker-compose.yml ports section).
# External access: http://localhost:80 → internal nginx:8080
