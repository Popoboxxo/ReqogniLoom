# Paste into ~/.codex/config.toml (global) or .codex/config.toml
# (project-scoped, trusted projects only).
# Replace the url host with your ReqogniLoom deployment and export
# REQOGNILOOM_API_KEY=reqlo_... before starting Codex CLI.
[mcp_servers.reqogniloom]
url = "https://your-reqogniloom-host/mcp/"
bearer_token_env_var = "REQOGNILOOM_API_KEY"
