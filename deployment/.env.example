# ReqogniLoom Production Environment — GHCR Deployment (docker-compose.ghcr.yml)
# IMPORTANT: This file contains production secrets. Keep it secure and NEVER commit it.

# ─────────────────────────────────────────────────────────
# Image Selection — GHCR (see .github/workflows/docker-publish.yml)
# ─────────────────────────────────────────────────────────
# GHCR_OWNER: GitHub org/user that owns the published images.
GHCR_OWNER=popoboxxo
# IMAGE_TAG: pin a released version (e.g. 1.2.0) or track `latest`.
# Pin a version in production — `latest` moves underneath you on every release.
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────
# Core Django Settings
# ─────────────────────────────────────────────────────────
# Generate a fresh SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(50))"
# NEVER use the same SECRET_KEY across deployments.
SECRET_KEY=

# Generate a fresh AUTH_JWT_SECRET with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=

DEBUG=False

# B1: HTTP → HTTPS redirect. DEFAULTS TO FALSE (opt-in).
# Set to True ONLY if a TLS-terminating reverse proxy (nginx, Traefik, HAProxy, etc.)
# is in front of this app and forwards traffic as plain HTTP with X-Forwarded-Proto: https.
# If True but no TLS proxy exists, ALL requests redirect to https:// where nothing listens
# → deployment becomes unreachable. Set to True in production behind a TLS proxy.
#SECURE_SSL_REDIRECT=True

# Comma-separated list of allowed hosts. Must include your domain/IP.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Field-level encryption key (REQUIRED — no default, startup fails without
# it). Encrypts persistence.LlmSettings.api_key at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without re-encrypting existing rows makes their stored
# api_key unreadable — keep it stable, and back it up like any other secret.
FIELD_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────
DB_NAME=reqogniloom
# Superuser (Postgres bootstrap role). Used ONLY by the one-shot `migrate`
# service to run schema migrations — RLS (REQ-L2-PL-010) does not restrict
# superusers, so this role must never be used for runtime request traffic.
DB_USER=reqogniloom
# Generate a strong password (32+ random chars):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
# Least-privilege application role (created by
# persistence/migrations/0048_app_role.py). backend/celery/celery-beat
# authenticate as this role so RLS tenant-isolation policies actually apply.
DB_APP_USER=reqogniloom_app
# Generate a strong password (32+ random chars):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_APP_PASSWORD=

# ─────────────────────────────────────────────────────────
# Redis (Celery broker)
# ─────────────────────────────────────────────────────────
# Generate a strong password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────
# Backup Strategy — REQ-102 (INF-21)
# ─────────────────────────────────────────────────────────
BACKUP_INTERVAL=86400
BACKUP_RETENTION=7
# Repo checkout path providing backend/scripts/backup_postgres.sh for the
# postgres-backup service. Only needed if you keep a repo checkout on this
# host; otherwise drop the postgres-backup service from the compose file.
REPO_ROOT=..

# ─────────────────────────────────────────────────────────
# LLM Provider — ARCH-L1-009 LlmAdapter
# ─────────────────────────────────────────────────────────
# Set LLM_PROVIDER to enable AI features (anthropic, openai, ollama, mock)
# If not set, gracefully degrades to mock (REQ-L1-032)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Issue #342: workspace-wide LLM tools (ai_derivation.derive_glossary_from_workspace,
# traceability.suggest_links, audit.ai_review) prompt over the entire workspace and
# need far longer than the per-artifact cap LLM_SYNC_TIMEOUT (25s). Seconds.
# NOTE: any HTTP proxy in front of the backend needs a matching read timeout
# (nginx defaults to 60s proxy_read_timeout).
LLM_LONG_RUNNING_TIMEOUT=180

# ─────────────────────────────────────────────────────────
# Multi-Tenancy
# ─────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=1

# ─────────────────────────────────────────────────────────
# System Admin Account (first-start self-init, REQ-188)
# ─────────────────────────────────────────────────────────
# The application self-initialises on first start via a post_migrate receiver
# that runs inside the one-shot `migrate` service: it provisions this admin
# account AND the base workspace's default workflows so login works
# immediately — no manual seed step, no separate bootstrap service.
# Provisioning is create-only: the password is set once, at user creation,
# and is never reset on later restarts. SYSTEM_ADMIN_PASSWORD is REQUIRED on
# a fresh system: without it the self-init logs a warning and skips admin
# creation. Choose a strong value for production.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_EMAIL=admin@demo.local
SYSTEM_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=80
