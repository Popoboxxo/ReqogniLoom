{
  "name": "reqflow-e2e",
  "version": "1.0.0",
  "scripts": {
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:debug": "node node_modules/@playwright/test/cli.js test --debug",
    "test:e2e:api": "node node_modules/@playwright/test/cli.js test tests/api/",
    "test:e2e:ai": "playwright test --reporter=line",
    "test:e2e:ai-mass": "playwright test --reporter=dot",
    "mcp:playwright": "npx -y @playwright/mcp@latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.0.0"
  }
}
