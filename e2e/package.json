{
  "name": "reqflow-e2e",
  "version": "1.0.0",
  "scripts": {
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:debug": "node node_modules/@playwright/test/cli.js test --debug",
    "test:e2e:api": "node node_modules/@playwright/test/cli.js test tests/api/",
    "test:e2e:ai": "playwright test --reporter=line",
    "test:e2e:ai-mass": "playwright test --reporter=dot",
    "check:unexpected-skips": "node scripts/check-unexpected-skips.mjs",
    "mcp:playwright": "npx @playwright/mcp@0.0.85"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/mcp": "0.0.85",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  }
}
