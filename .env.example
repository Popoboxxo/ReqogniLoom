# ReqFlow Environment Variables
# Copy to .env and adjust values before running.
# NEVER commit .env with real secrets.
#
# Architecture: ADR-08 (Self-Hosted Docker Compose)
# ─────────────────────────────────────────────────────────

# ─── Django Security ────────────────────────────────────
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── PostgreSQL (ARCH-L1-010 PersistenceLayer) ──────────
DB_NAME=reqflow
DB_USER=reqflow
DB_PASSWORD=reqflow
# DB_HOST and DB_PORT are set to service names in docker-compose.yml
# Override here only for external database connections:
# DB_HOST=localhost
# DB_PORT=5432

# ─── Tenant (ADR-03, ARCH-L1-011) ───────────────────────
# v1: single default tenant. v2: no data migration required.
DEFAULT_TENANT_ID=1

# ─── LLM Provider (ARCH-L1-009 LlmAdapter, ADR-02) ─────
# Supported: mock | anthropic | openai | ollama | azure
# Set to 'mock' for local development without AI features.
# Core functionality (CRUD, Traceability, Baselines) works without LLM.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Examples:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022

# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1

# ─── Celery / Redis (ARCH-L1-016 ResilienceOrchestrator) ─
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Frontend (ARCH-L1-001 ReactFrontend) ───────────────
VITE_API_BASE_URL=http://localhost:8000
