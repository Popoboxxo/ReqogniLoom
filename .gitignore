# Proof artefacts from e2e/tests/system-proof-journey.spec.ts (screenshots +
# captured JSON-RPC/REST bodies). Regenerated on every run, so they are not
# tracked - the spec is the durable artefact, these are its evidence.
e2e/proof/

# Frontend build artifacts (vite config emit + tsc incremental build info)
frontend/tsconfig*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Run artefacts from e2e/tests/waterkettle-fullblown.spec.ts: its bug report and
# the per-finding files are rewritten on every run (the report embeds a
# timestamp), so tracking them left the working tree permanently dirty with
# differences that carry no information. Same reasoning as e2e/proof/ above - the
# spec is the durable artefact. Issue #947 review F-9.
e2e/tests/wk-bug-report.md
e2e/tests/wk-bugs/
# Build output — generated by the Vite/Docker build step
frontend/dist/

# Prompt-regression build artifacts (plan D / D2.3). The generated promptfoo
# configs and eval results are rebuilt on every run; the checked-in source of
# truth is backend/application/prompt_testing/cases/*.yaml.
promptfoo/generated/
promptfoo/results*.json
promptfoo/node_modules/

# Qdrant snapshots are tenant data (vectors + tenant_id/workspace_id/entity_id
# payload): a full copy of the index, i.e. a database dump. They belong outside
# the checkout (deploy/README.md, "Snapshots of the artifact collections");
# never commit one even if a copy is made into the tree by mistake. The
# `.snapshot.checksum` sidecar Qdrant writes next to each file is matched too.
*.snapshot
*.snapshot.checksum
