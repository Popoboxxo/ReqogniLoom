# ReqFlow Environment Variables (generated for local dev)
SECRET_KEY=dev-key-not-for-production-change-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL
DB_NAME=reqflow
DB_USER=reqflow
DB_PASSWORD=reqflow

# Tenant
DEFAULT_TENANT_ID=1

# LLM Provider - mock for local development (no AI calls)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000
