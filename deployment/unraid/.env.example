# ReqogniLoom Production Environment Configuration — Unraid Deployment
# Last updated: 2026-07-16
# IMPORTANT: This file contains production secrets. Keep it secure and NEVER commit to public repos.
# For Unraid deployments, this file is kept local (not in version control).

# ─────────────────────────────────────────────────────────
# Local Build — Repo Location (only needed for `build:` fallback)
# ─────────────────────────────────────────────────────────
# Required if deploying via Unraid's Docker Compose Manager plugin: that
# plugin stores its own copy of the compose file under
# /boot/config/plugins/compose.manager/projects/<name>/, not inside your
# repo checkout, so the default relative build context (../../backend)
# resolves to the wrong path and the build fails with
# "unable to prepare context: path ... not found".
# Set this to the absolute path of the actual repo checkout on this host:
# REPO_ROOT=/mnt/user/appdata/ai-native-reqogniloom-POC
#
# Not needed if you run `docker compose` directly from within the repo
# (deployment/unraid/), or if you're pulling pre-built images with no
# `build:` fallback.
REPO_ROOT=

# ─────────────────────────────────────────────────────────
# Core Django Settings
# ─────────────────────────────────────────────────────────
# Generate a fresh SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(50))"
# NEVER use the same SECRET_KEY across deployments.
SECRET_KEY=

# Generate a fresh AUTH_JWT_SECRET with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
AUTH_JWT_SECRET=

# Field-level encryption key (REQUIRED — no default, startup fails without
# it). Encrypts persistence.LlmSettings.api_key at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key without re-encrypting existing rows makes their stored
# api_key unreadable — keep it stable, and back it up like any other secret.
FIELD_ENCRYPTION_KEY=

DEBUG=True

# Controls the `Secure` flag on the httpOnly auth cookie. Defaults to `not DEBUG`
# (i.e. False here since DEBUG=True). If you set DEBUG=False but still serve
# this app over plain HTTP (no reverse-proxy TLS termination, e.g. a bare
# internal IP), explicitly set AUTH_COOKIE_SECURE=False — otherwise the
# browser silently drops the login cookie and every request after login fails.
AUTH_COOKIE_SECURE=False

# Comma-separated list of allowed hosts. Must include your domain and local IPs.
ALLOWED_HOSTS=your-domain.example.com,<your-unraid-host-ip>,localhost,127.0.0.1,backend

# ─────────────────────────────────────────────────────────
# CORS & CSRF Security — REQ-081, REQ-138
# ─────────────────────────────────────────────────────────
# CORS_ALLOWED_ORIGINS: Frontend cross-origin requests from these origins
# Example: if frontend is served from https://your-domain.example.com, add it here
CORS_ALLOWED_ORIGINS=https://your-domain.example.com

# CSRF_TRUSTED_ORIGINS: POST/PATCH/DELETE requests from these origins bypass CSRF checks
# Must match CORS_ALLOWED_ORIGINS for full SPA support
CSRF_TRUSTED_ORIGINS=https://your-domain.example.com

# ─────────────────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ─────────────────────────────────────────────────────────
DB_NAME=reqogniloom
# Superuser (Postgres bootstrap role). Used ONLY by the one-shot `migrate`
# service to run schema migrations — RLS (REQ-L2-PL-010) does not restrict
# superusers, so this role must never be used for runtime request traffic.
DB_USER=reqogniloom
# Generate a strong password (32+ random chars):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
# Least-privilege application role (created by
# persistence/migrations/0048_app_role.py). backend/celery/celery-beat
# authenticate as this role so RLS tenant-isolation policies actually apply.
DB_APP_USER=reqogniloom_app
# Generate a strong password (32+ random chars):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_APP_PASSWORD=

# ─────────────────────────────────────────────────────────
# Redis (Celery broker)
# ─────────────────────────────────────────────────────────
# Generate a strong password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────
# Backup Strategy — REQ-102 (INF-21)
# ─────────────────────────────────────────────────────────
# BACKUP_INTERVAL: seconds between backups (default 86400 = 24h)
BACKUP_INTERVAL=86400
# BACKUP_RETENTION: number of backups to keep (default 7)
BACKUP_RETENTION=7

# ─────────────────────────────────────────────────────────
# LLM Provider — ARCH-L1-009 LlmAdapter
# ─────────────────────────────────────────────────────────
# Set LLM_PROVIDER to enable AI features (anthropic, openai, ollama, mock)
# If not set, gracefully degrades to mock (REQ-L1-032)
LLM_PROVIDER=ollama

# For Ollama: local instance on Unraid
# Verify model availability with: ollama list
# https://ollama.ai/models
LLM_BASE_URL=http://<your-ollama-host>:11434

# Model tag — verify it exists on your Ollama instance before startup!
# qwen2.5:14b-instruct-q4_K_M requires ~9GB VRAM (Q4_K_M quantization)
# Note: "qwen3.6:35b-a3b" does NOT exist. Qwen doesn't have a "3.6" version.
#       For high-performance: qwen3:30b-a3b (~18-19GB VRAM at Q4)
#       For lower VRAM: qwen2.5:14b-instruct-q4_K_M (~9GB VRAM)
LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Optional API key if using cloud LLM providers (Anthropic, OpenAI)
LLM_API_KEY=

# ─────────────────────────────────────────────────────────
# Frontend Build Configuration — Vite
# ─────────────────────────────────────────────────────────
# IMPORTANT: These values are BAKED INTO the production Docker image at build time.
# After changing these, you MUST rebuild the frontend:
#   docker-compose build frontend
#
# Then restart the container:
#   docker-compose restart frontend
#
# These are NOT runtime-configurable — they are Vite build-time variables.

# API backend URL that the frontend will call
# Must be reachable from the browser (e.g., https://your-domain.example.com:8443 or https://api.your-domain.example.com)
# Default: http://localhost:8000 (dev only)
VITE_API_BASE_URL=https://your-domain.example.com:8443

# Comma-separated list of allowed hosts for the frontend
VITE_ALLOWED_HOSTS=your-domain.example.com

# ─────────────────────────────────────────────────────────
# Multi-Tenancy & Feature Flags
# ─────────────────────────────────────────────────────────
DEFAULT_TENANT_ID=1

# ─────────────────────────────────────────────────────────
# System Admin Account (first-start self-init, REQ-188)
# ─────────────────────────────────────────────────────────
# The application self-initialises on first start via a post_migrate receiver
# that runs inside the one-shot `migrate` service (docker-compose.yaml): it
# provisions this admin account AND the base workspace's default workflows so
# login works immediately — no manual seed step, no separate bootstrap
# service. Provisioning is create-only: the password is set once, at user
# creation, and is never reset on later restarts (an admin who changed their
# password via the UI keeps it). Username/email are optional (defaults
# below). SYSTEM_ADMIN_PASSWORD is REQUIRED on a fresh system: without it the
# self-init logs a warning and skips admin creation. Choose a strong value
# for production.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_EMAIL=admin@demo.local
SYSTEM_ADMIN_PASSWORD=CHANGE-ME-strong-admin-password
